        <Ellipse Canvas.Left="469.3" Canvas.Top="85.3" Width="1.6" Height="1.6" Fill="#FFFFFF" Opacity="0.7"/>
        <Ellipse x:Name="Star5" Canvas.Left="714.5" Canvas.Top="64.7" Width="2" Height="2" Fill="#FFFFFF" Opacity="0.9"/>
        <Ellipse Canvas.Left="528.4" Canvas.Top="110.6" Width="2" Height="2" Fill="#FFFFFF" Opacity="0.7"/>
        <Ellipse Canvas.Left="658.4" Canvas.Top="75.8" Width="2.6" Height="2.6" Fill="#FFFFFF" Opacity="0.9"/>
        <!-- sun -->
        <Ellipse x:Name="SunGlow" Canvas.Left="350" Canvas.Top="100" Width="540" Height="400">
          <Ellipse.Fill>
