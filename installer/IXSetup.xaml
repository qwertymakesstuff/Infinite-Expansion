<?xml version="1.0" encoding="utf-8"?>
<!--
  Infinite Expansion - setup window (WPF), loaded by IXSetup.ps1 with XamlReader.Load,
  so there is no code-behind: no x:Class and no event attributes. Controls the script
  uses carry an x:Name listed in IXSetup.ps1 ($IXControlNames).

  Original artwork, drawn here in vectors: an 80s synthwave night with a striped sun,
  a neon ferris wheel, a scrolling pink grid floor, toxic fog, and zombie hands
  rising from the ground. Coordinates are in an 880 x 560 canvas; the horizon is at
  y 330 and the grid's vanishing point at x 620, the sun's centre.
-->
<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Infinite Expansion Setup"
    Width="880" Height="560"
    WindowStyle="None" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
    Background="#07040D" Foreground="#EDE7FF" FontFamily="Segoe UI" FontSize="13"
    UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

  <Window.Resources>
    <SolidColorBrush x:Key="PinkBrush" Color="#FF2E97"/>
    <SolidColorBrush x:Key="CyanBrush" Color="#22E4FF"/>
    <SolidColorBrush x:Key="ToxicBrush" Color="#39FF14"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#9C92BC"/>
    <SolidColorBrush x:Key="DimBrush" Color="#6C6285"/>

    <LinearGradientBrush x:Key="ChromeBrush" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#FFFFFF" Offset="0"/>
      <GradientStop Color="#9BF6FF" Offset="0.48"/>
      <GradientStop Color="#22E4FF" Offset="0.52"/>
      <GradientStop Color="#8A2BE2" Offset="1"/>
    </LinearGradientBrush>

    <DrawingImage x:Key="HandImage">
      <DrawingImage.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="Transparent" Geometry="M0,0 H110 V240 H0 Z"/>
          <GeometryDrawing Geometry="M33,121 L19,105 L12,87 M41,94 L35,63 L37,35 M55,90 L56,53 L58,21 M69,92 L77,61 L74,36 M81,100 L93,81 L93,63">
            <GeometryDrawing.Pen>
              <Pen Brush="#39FF14" Thickness="15" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/>
            </GeometryDrawing.Pen>
          </GeometryDrawing>
          <GeometryDrawing Brush="#39FF14" Geometry="M35,91 L85,94 L90,129 L80,151 L44,151 L31,128 Z M44,148 L80,148 L83,185 L41,185 Z">
            <GeometryDrawing.Pen>
              <Pen Brush="#39FF14" Thickness="4" LineJoin="Round"/>
            </GeometryDrawing.Pen>
          </GeometryDrawing>
          <GeometryDrawing Brush="#39FF14" Geometry="M34,182 L42,172 L48,180 L55,169 L62,179 L69,170 L76,180 L84,171 L91,184 L95,240 L29,240 Z">
            <GeometryDrawing.Pen>
              <Pen Brush="#39FF14" Thickness="4" LineJoin="Round"/>
            </GeometryDrawing.Pen>
          </GeometryDrawing>
          <GeometryDrawing Geometry="M33,121 L19,105 L12,87 M41,94 L35,63 L37,35 M55,90 L56,53 L58,21 M69,92 L77,61 L74,36 M81,100 L93,81 L93,63">
            <GeometryDrawing.Pen>
              <Pen Brush="#0A0612" Thickness="11" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/>
            </GeometryDrawing.Pen>
          </GeometryDrawing>
          <GeometryDrawing Brush="#0A0612" Geometry="M35,91 L85,94 L90,129 L80,151 L44,151 L31,128 Z M44,148 L80,148 L83,185 L41,185 Z"/>
          <GeometryDrawing Brush="#1C0A2B" Geometry="M34,182 L42,172 L48,180 L55,169 L62,179 L69,170 L76,180 L84,171 L91,184 L95,240 L29,240 Z"/>
        </DrawingGroup>
      </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Big green action button -->
    <Style x:Key="NeonButton" TargetType="Button">
      <Setter Property="Foreground" Value="#041006"/>
      <Setter Property="FontSize" Value="19"/>
      <Setter Property="FontWeight" Value="Black"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="8" BorderThickness="1" BorderBrush="#C8FFB8" RenderTransformOrigin="0.5,0.5">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                  <GradientStop Color="#6BFF4F" Offset="0"/>
                  <GradientStop Color="#25C80B" Offset="1"/>
                </LinearGradientBrush>
              </Border.Background>
              <Border.Effect>
                <DropShadowEffect Color="#39FF14" BlurRadius="18" ShadowDepth="0" Opacity="0.55"/>
              </Border.Effect>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Effect">
                  <Setter.Value>
                    <DropShadowEffect Color="#39FF14" BlurRadius="32" ShadowDepth="0" Opacity="1"/>
                  </Setter.Value>
                </Setter>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="RenderTransform">
                  <Setter.Value>
                    <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                  </Setter.Value>
                </Setter>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.3"/>
                <Setter TargetName="Bd" Property="Effect" Value="{x:Null}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Outlined pink button -->
    <Style x:Key="GhostButton" TargetType="Button">
      <Setter Property="Foreground" Value="#FF2E97"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="8" BorderThickness="1.5" BorderBrush="#FF2E97" Background="#0DFF2E97" RenderTransformOrigin="0.5,0.5">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#33FF2E97"/>
                <Setter TargetName="Bd" Property="Effect">
                  <Setter.Value>
                    <DropShadowEffect Color="#FF2E97" BlurRadius="24" ShadowDepth="0" Opacity="0.9"/>
                  </Setter.Value>
                </Setter>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="RenderTransform">
                  <Setter.Value>
                    <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                  </Setter.Value>
                </Setter>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.3"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Text-only cyan button (BROWSE, links) -->
    <Style x:Key="LinkButton" TargetType="Button">
      <Setter Property="Foreground" Value="#22E4FF"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Foreground" Value="#FFFFFF"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- Title bar buttons -->
    <Style x:Key="ChromeButton" TargetType="Button">
      <Setter Property="Foreground" Value="#C9C0E6"/>
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CloseButton" TargetType="Button">
      <Setter Property="Foreground" Value="#C9C0E6"/>
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#E81123"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#9C92BC"/>
    </Style>
    <Style x:Key="Value" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Foreground" Value="#EDE7FF"/>
      <Setter Property="Margin" Value="0,2,0,0"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="Dot" TargetType="Ellipse">
      <Setter Property="Width" Value="10"/>
      <Setter Property="Height" Value="10"/>
      <Setter Property="Fill" Value="#6C6285"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>
  </Window.Resources>

  <Window.Triggers>
    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
      <BeginStoryboard>
        <Storyboard>
          <DoubleAnimation Storyboard.TargetName="GridLine0" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="0" To="230" Duration="0:0:3.6" BeginTime="0:0:0.00" RepeatBehavior="Forever">
            <DoubleAnimation.EasingFunction><PowerEase Power="2.4" EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
          </DoubleAnimation>
          <DoubleAnimation Storyboard.TargetName="GridLine0" Storyboard.TargetProperty="Opacity" From="0.1" To="0.95" Duration="0:0:3.6" BeginTime="0:0:0.00" RepeatBehavior="Forever">
            <DoubleAnimation.EasingFunction><PowerEase Power="2" EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
          </DoubleAnimation>
          <DoubleAnimation Storyboard.TargetName="GridLine1" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="0" To="230" Duration="0:0:3.6" BeginTime="0:0:0.45" RepeatBehavior="Forever">
            <DoubleAnimation.EasingFunction><PowerEase Power="2.4" EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
          </DoubleAnimation>
          <DoubleAnimation Storyboard.TargetName="GridLine1" Storyboard.TargetProperty="Opacity" From="0.1" To="0.95" Duration="0:0:3.6" BeginTime="0:0:0.45" RepeatBehavior="Forever">
            <DoubleAnimation.EasingFunction><PowerEase Power="2" EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
          </DoubleAnimation>
          <DoubleAnimation Storyboard.TargetName="GridLine2" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="0" To="230" Duration="0:0:3.6" BeginTime="0:0:0.90" RepeatBehavior="Forever">
            <DoubleAnimation.EasingFunction><PowerEase Power="2.4" EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
          </DoubleAnimation>
          <DoubleAnimation Storyboard.TargetName="GridLine2" Storyboard.TargetProperty="Opacity" From="0.1" To="0.95" Duration="0:0:3.6" BeginTime="0:0:0.90" RepeatBehavior="Forever">
            <DoubleAnimation.EasingFunction><PowerEase Power="2" EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
          </DoubleAnimation>
          <DoubleAnimation Storyboard.TargetName="GridLine3" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="0" To="230" Duration="0:0:3.6" BeginTime="0:0:1.35" RepeatBehavior="Forever">
            <DoubleAnimation.EasingFunction><PowerEase Power="2.4" EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
          </DoubleAnimation>
          <DoubleAnimation Storyboard.TargetName="GridLine3" Storyboard.TargetProperty="Opacity" From="0.1" To="0.95" Duration="0:0:3.6" BeginTime="0:0:1.35" RepeatBehavior="Forever">
            <DoubleAnimation.EasingFunction><PowerEase Power="2" EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
          </DoubleAnimation>
          <DoubleAnimation Storyboard.TargetName="GridLine4" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="0" To="230" Duration="0:0:3.6" BeginTime="0:0:1.80" RepeatBehavior="Forever">
            <DoubleAnimation.EasingFunction><PowerEase Power="2.4" EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
          </DoubleAnimation>
          <DoubleAnimation Storyboard.TargetName="GridLine4" Storyboard.TargetProperty="Opacity" From="0.1" To="0.95" Duration="0:0:3.6" BeginTime="0:0:1.80" RepeatBehavior="Forever">
            <DoubleAnimation.EasingFunction><PowerEase Power="2" EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
          </DoubleAnimation>
          <DoubleAnimation Storyboard.TargetName="GridLine5" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="0" To="230" Duration="0:0:3.6" BeginTime="0:0:2.25" RepeatBehavior="Forever">
            <DoubleAnimation.EasingFunction><PowerEase Power="2.4" EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
          </DoubleAnimation>
          <DoubleAnimation Storyboard.TargetName="GridLine5" Storyboard.TargetProperty="Opacity" From="0.1" To="0.95" Duration="0:0:3.6" BeginTime="0:0:2.25" RepeatBehavior="Forever">
            <DoubleAnimation.EasingFunction><PowerEase Power="2" EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
          </DoubleAnimation>
          <DoubleAnimation Storyboard.TargetName="GridLine6" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="0" To="230" Duration="0:0:3.6" BeginTime="0:0:2.70" RepeatBehavior="Forever">
            <DoubleAnimation.EasingFunction><PowerEase Power="2.4" EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
          </DoubleAnimation>
          <DoubleAnimation Storyboard.TargetName="GridLine6" Storyboard.TargetProperty="Opacity" From="0.1" To="0.95" Duration="0:0:3.6" BeginTime="0:0:2.70" RepeatBehavior="Forever">
            <DoubleAnimation.EasingFunction><PowerEase Power="2" EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
          </DoubleAnimation>
          <DoubleAnimation Storyboard.TargetName="GridLine7" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="0" To="230" Duration="0:0:3.6" BeginTime="0:0:3.15" RepeatBehavior="Forever">
            <DoubleAnimation.EasingFunction><PowerEase Power="2.4" EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
          </DoubleAnimation>
          <DoubleAnimation Storyboard.TargetName="GridLine7" Storyboard.TargetProperty="Opacity" From="0.1" To="0.95" Duration="0:0:3.6" BeginTime="0:0:3.15" RepeatBehavior="Forever">
            <DoubleAnimation.EasingFunction><PowerEase Power="2" EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
          </DoubleAnimation>
          <DoubleAnimation Storyboard.TargetName="Wheel" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:50" RepeatBehavior="Forever"/>
          <DoubleAnimation Storyboard.TargetName="SunGlow" Storyboard.TargetProperty="Opacity" From="0.6" To="1" Duration="0:0:3.5" AutoReverse="True" RepeatBehavior="Forever">
            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
          </DoubleAnimation>
          <DoubleAnimation Storyboard.TargetName="Fog" Storyboard.TargetProperty="Opacity" From="0.45" To="1" Duration="0:0:4.5" AutoReverse="True" RepeatBehavior="Forever">
            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
          </DoubleAnimation>
          <DoubleAnimation Storyboard.TargetName="Star1" Storyboard.TargetProperty="Opacity" From="0.15" To="1" Duration="0:0:1.7" BeginTime="0:0:0" AutoReverse="True" RepeatBehavior="Forever"/>
          <DoubleAnimation Storyboard.TargetName="Star2" Storyboard.TargetProperty="Opacity" From="0.15" To="1" Duration="0:0:2.3" BeginTime="0:0:0.6" AutoReverse="True" RepeatBehavior="Forever"/>
          <DoubleAnimation Storyboard.TargetName="Star3" Storyboard.TargetProperty="Opacity" From="0.15" To="1" Duration="0:0:2.9" BeginTime="0:0:1.1" AutoReverse="True" RepeatBehavior="Forever"/>
          <DoubleAnimation Storyboard.TargetName="Star4" Storyboard.TargetProperty="Opacity" From="0.15" To="1" Duration="0:0:2.0" BeginTime="0:0:1.7" AutoReverse="True" RepeatBehavior="Forever"/>
          <DoubleAnimation Storyboard.TargetName="Star5" Storyboard.TargetProperty="Opacity" From="0.15" To="1" Duration="0:0:2.6" BeginTime="0:0:0.3" AutoReverse="True" RepeatBehavior="Forever"/>
          <DoubleAnimation Storyboard.TargetName="Hand1" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)" To="0" Duration="0:0:1.5" BeginTime="0:0:0.30">
            <DoubleAnimation.EasingFunction><BackEase Amplitude="0.35" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
          </DoubleAnimation>
          <DoubleAnimation Storyboard.TargetName="Hand1" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(RotateTransform.Angle)" From="-11" To="-7" Duration="0:0:3.1" BeginTime="0:0:1.80" AutoReverse="True" RepeatBehavior="Forever">
            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
          </DoubleAnimation>
          <DoubleAnimation Storyboard.TargetName="Hand2" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)" To="0" Duration="0:0:1.5" BeginTime="0:0:0.55">
            <DoubleAnimation.EasingFunction><BackEase Amplitude="0.35" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
          </DoubleAnimation>
          <DoubleAnimation Storyboard.TargetName="Hand2" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(RotateTransform.Angle)" From="5" To="9" Duration="0:0:2.6" BeginTime="0:0:2.05" AutoReverse="True" RepeatBehavior="Forever">
            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
          </DoubleAnimation>
          <DoubleAnimation Storyboard.TargetName="Hand3" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)" To="0" Duration="0:0:1.5" BeginTime="0:0:0.80">
            <DoubleAnimation.EasingFunction><BackEase Amplitude="0.35" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
          </DoubleAnimation>
          <DoubleAnimation Storyboard.TargetName="Hand3" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(RotateTransform.Angle)" From="13" To="17" Duration="0:0:3.4" BeginTime="0:0:2.30" AutoReverse="True" RepeatBehavior="Forever">
            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
          </DoubleAnimation>
        </Storyboard>
      </BeginStoryboard>
    </EventTrigger>
  </Window.Triggers>

  <Border BorderThickness="1">
    <Border.BorderBrush>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF2E97" Offset="0"/>
        <GradientStop Color="#8A2BE2" Offset="0.5"/>
        <GradientStop Color="#22E4FF" Offset="1"/>
      </LinearGradientBrush>
    </Border.BorderBrush>
    <Grid>
      <Canvas ClipToBounds="True" IsHitTestVisible="False">
        <!-- sky -->
        <Rectangle Width="880" Height="330">
          <Rectangle.Fill>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <GradientStop Color="#090313" Offset="0"/>
              <GradientStop Color="#1A0832" Offset="0.55"/>
              <GradientStop Color="#3D0E52" Offset="1"/>
            </LinearGradientBrush>
          </Rectangle.Fill>
        </Rectangle>
        <Ellipse Canvas.Left="598.7" Canvas.Top="85.2" Width="1.6" Height="1.6" Fill="#FFFFFF" Opacity="0.35"/>
