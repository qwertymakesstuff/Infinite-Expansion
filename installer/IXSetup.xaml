      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="38"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- title bar: drag to move -->
        <Grid x:Name="TitleBar" Grid.Row="0" Background="Transparent">
          <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
            <Border BorderBrush="#FF2E97" BorderThickness="1.5" CornerRadius="3" Padding="5,0">
              <TextBlock Text="IX" FontSize="10" FontWeight="Black" Foreground="#FF2E97"/>
            </Border>
            <TextBlock Text="INFINITE EXPANSION  &#183;  SETUP" Margin="10,0,0,0" FontSize="11" FontWeight="SemiBold" Foreground="#9C92BC" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
            <Button x:Name="MinButton" Style="{StaticResource ChromeButton}" ToolTip="Minimize">
              <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
            </Button>
            <Button x:Name="CloseButton" Style="{StaticResource CloseButton}" ToolTip="Close">
              <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
            </Button>
          </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Margin="44,4,0,0" Width="430" HorizontalAlignment="Left">
          <StackPanel Margin="6,0,0,0">
            <StackPanel.RenderTransform>
              <SkewTransform AngleX="-8"/>
            </StackPanel.RenderTransform>
            <StackPanel.Effect>
              <DropShadowEffect Color="#FF2E97" BlurRadius="26" ShadowDepth="0" Opacity="0.85"/>
            </StackPanel.Effect>
            <TextBlock Text="INFINITE" FontFamily="Segoe UI Black, Arial Black" FontSize="52" Foreground="{StaticResource ChromeBrush}" LineHeight="52" LineStackingStrategy="BlockLineHeight"/>
            <TextBlock Text="EXPANSION" FontFamily="Segoe UI Black, Arial Black" FontSize="52" Foreground="{StaticResource ChromeBrush}" LineHeight="52" LineStackingStrategy="BlockLineHeight"/>
          </StackPanel>

          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock Text="ZOMBIES ENHANCEMENT MOD" FontSize="13" FontWeight="Bold" Foreground="#39FF14" VerticalAlignment="Center"/>
            <Border BorderBrush="#FF2E97" BorderThickness="1" CornerRadius="9" Padding="8,1" Margin="10,0,0,0" VerticalAlignment="Center">
              <TextBlock x:Name="VersionText" Text="v?" FontSize="11" Foreground="#FF2E97"/>
            </Border>
          </StackPanel>
          <TextBlock Text="for Call of Duty: Infinite Warfare, with the iw7-mod client" Margin="0,2,0,0" FontSize="12" Foreground="#9C92BC"/>

          <Border Margin="0,14,0,0" Padding="18,10,14,10" CornerRadius="10" Background="#D90D0718" BorderBrush="#59FF2E97" BorderThickness="1">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <Ellipse x:Name="GameDot" Grid.Row="0" Style="{StaticResource Dot}"/>
              <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,2">
                <TextBlock Text="GAME FOLDER" Style="{StaticResource Label}"/>
                <TextBlock x:Name="GameText" Text="Looking for the game..." Style="{StaticResource Value}" FontFamily="Consolas, Segoe UI"/>
              </StackPanel>
              <Button x:Name="BrowseButton" Grid.Row="0" Grid.Column="2" Content="BROWSE" Style="{StaticResource LinkButton}" Padding="10,6" ToolTip="Pick iw7_ship.exe in your Infinite Warfare folder"/>

              <Ellipse x:Name="ClientDot" Grid.Row="1" Style="{StaticResource Dot}"/>
              <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,4,0,2">
                <TextBlock Text="IW7-MOD CLIENT" Style="{StaticResource Label}"/>
                <TextBlock x:Name="ClientText" Text="-" Style="{StaticResource Value}"/>
              </StackPanel>
              <Button x:Name="ClientLink" Grid.Row="1" Grid.Column="2" Content="GET IT" Style="{StaticResource LinkButton}" Padding="10,6" Visibility="Collapsed" ToolTip="Open the iw7-mod page"/>

              <Ellipse x:Name="ModDot" Grid.Row="2" Style="{StaticResource Dot}"/>
              <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,4,0,2">
                <TextBlock Text="INFINITE EXPANSION" Style="{StaticResource Label}"/>
                <TextBlock x:Name="ModText" Text="-" Style="{StaticResource Value}"/>
              </StackPanel>

              <TextBlock x:Name="NoteText" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,6,0,0" FontSize="11.5" Foreground="#FFE66D" TextWrapping="Wrap" Visibility="Collapsed"/>
            </Grid>
          </Border>

          <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <Button x:Name="InstallButton" Style="{StaticResource NeonButton}" Width="196" Height="52" Content="INSTALL"/>
            <Button x:Name="UninstallButton" Style="{StaticResource GhostButton}" Width="160" Height="52" Margin="14,0,0,0" Content="UNINSTALL"/>
          </StackPanel>

          <TextBlock x:Name="StatusTitle" Margin="0,14,0,0" FontSize="13" FontWeight="Bold" Foreground="#39FF14" Text=" "/>
          <TextBlock x:Name="StatusText" Margin="0,3,0,0" FontSize="12" Foreground="#C9C0E6" TextWrapping="Wrap" Text=" "/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="44,0,0,12">
          <TextBlock Text="Fan-made mod. Not affiliated with Activision or Infinity Ward." FontSize="10.5" Foreground="#6C6285" VerticalAlignment="Center"/>
          <Button x:Name="RepoLink" Content="Project page" Style="{StaticResource LinkButton}" FontWeight="Normal" FontSize="10.5" Padding="8,2"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
